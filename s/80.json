{"n":80,"ayat":[{"a":1,"ar":"عَبَسَ وَتَوَلّٰىٓۙ","la":"‘Abasa wa tawallā.","id":"Dia (Nabi Muhammad) berwajah masam dan berpaling","m":["dia bermuka masam","dan dia berpaling"]},{"a":2,"ar":"اَنْ جَاۤءَهُ الْاَعْمٰىۗ","la":"An jā'ahul-a‘mā.","id":"karena seorang tunanetra (Abdullah bin Ummi Maktum) telah datang kepadanya.","m":["sesungguhnya","datang kepadanya","seorang buta"]},{"a":3,"ar":"وَمَا يُدْرِيْكَ لَعَلَّهٗ يَزَّكّٰىٓۙ","la":"Wa mā yudrīka la‘allahū yazzakkā.","id":"Tahukah engkau (Nabi Muhammad) boleh jadi dia ingin menyucikan dirinya (dari dosa)","m":["dan apakah","tahukah kamu","barangkali dia","ia membersihkan diri"]},{"a":4,"ar":"اَوْ يَذَّكَّرُ فَتَنْفَعَهُ الذِّكْرٰىۗ","la":"Au yażżakkaru fatanfa‘ahuż-żikrā.","id":"atau dia (ingin) mendapatkan pengajaran sehingga pengajaran itu bermanfaat baginya?","m":["atau","ia mendapatkan pengajaran","lalu memberi manfaat kepadanya","pengajaran"]},{"a":5,"ar":"اَمَّا مَنِ اسْتَغْنٰىۙ","la":"Ammā manistagnā.","id":"Adapun orang yang merasa dirinya serba cukup (para pembesar Quraisy),","m":["adapun","siapa","merasa kaya/cukup"]},{"a":6,"ar":"فَاَنْتَ لَهٗ تَصَدّٰىۗ","la":"Fa anta lahū taṣaddā.","id":"engkau (Nabi Muhammad) memberi perhatian kepadanya.","m":["maka kamu","kepadanya","menghadapi/layani"]},{"a":7,"ar":"وَمَا عَلَيْكَ اَلَّا يَزَّكّٰىۗ","la":"Wa mā ‘alaika allā yazzakkā.","id":"Padahal, tidak ada (cela) atasmu kalau dia tidak menyucikan diri (beriman).","m":["dan tidak","atasmu","bahwa tidak","ia membersihkan diri"]},{"a":8,"ar":"وَاَمَّا مَنْ جَاۤءَكَ يَسْعٰىۙ","la":"Wa ammā man jā'aka yas‘ā.","id":"Adapun orang yang datang kepadamu dengan bersegera (untuk mendapatkan pengajaran),","m":["dan adapun","siapa/orang","datang kapadamu","berjalan/bersegera"]},{"a":9,"ar":"وَهُوَ يَخْشٰىۙ","la":"Wa huwa yakhsyā.","id":"sedangkan dia takut (kepada Allah),","m":["dan dia","ia takut"]},{"a":10,"ar":"فَاَنْتَ عَنْهُ تَلَهّٰىۚ","la":"Fa anta ‘anhu talahhā.","id":"malah engkau (Nabi Muhammad) abaikan.","m":["maka kamu","dari padanya","kamu mengabaikannya"]},{"a":11,"ar":"كَلَّآ اِنَّهَا تَذْكِرَةٌ ۚ","la":"Kallā innahā tażkirah(tun).","id":"Sekali-kali jangan (begitu)! Sesungguhnya (ajaran Allah) itu merupakan peringatan.","m":["sekali-kali jangan/tidak","sesungguhnya ia/itu","peringatan/pengajaran"]},{"a":12,"ar":"فَمَنْ شَاۤءَ ذَكَرَهٗ ۘ","la":"Faman syā'a żakarah(ū).","id":"Siapa yang menghendaki tentulah akan memperhatikannya","m":["maka barang siapa","ia menghendaki","ia mengingat/memperhatikannya"]},{"a":13,"ar":"فِيْ صُحُفٍ مُّكَرَّمَةٍۙ","la":"Fī ṣuḥufim mukarrmah(tin).","id":"di dalam suhuf yang dimuliakan (di sisi Allah),","m":["dalam","lembaran-lembaran","dimuliakan"]},{"a":14,"ar":"مَّرْفُوْعَةٍ مُّطَهَّرَةٍ ۢ ۙ","la":"Marfū‘atim muṭahharah(tin).","id":"yang ditinggikan (kedudukannya) lagi disucikan","m":["ditinggikan","disucikan"]},{"a":15,"ar":"بِاَيْدِيْ سَفَرَةٍۙ","la":"Bi'aidī safarah(tin).","id":"di tangan para utusan (malaikat)","m":["di tangan-tangan","para utusan"]},{"a":16,"ar":"كِرَامٍۢ بَرَرَةٍۗ","la":"Kirāmim bararah(tin).","id":"yang mulia lagi berbudi.","m":["yang mulia","yang berbakti"]},{"a":17,"ar":"قُتِلَ الْاِنْسَانُ مَآ اَكْفَرَهٗۗ","la":"Qutilal-insānu mā akfarah(ū).","id":"Celakalah manusia! Alangkah kufur dia!","m":["dibunuh/binasa","manusia","apa","kekafirannya"]},{"a":18,"ar":"مِنْ اَيِّ شَيْءٍ خَلَقَهٗۗ","la":"Min ayyi syai'in khalaqah(ū).","id":"Dari apakah Dia menciptakannya?","m":["dari","apa","sesuatu","Dia menciptakannya"]},{"a":19,"ar":"مِنْ نُّطْفَةٍۗ خَلَقَهٗ فَقَدَّرَهٗۗ","la":"Min nuṭfah(tin), khalaqahū fa qaddarah(ū).","id":"Dia menciptakannya dari setetes mani, lalu menentukan (takdir)-nya.","m":["dari","setetes mani","Dia menciptakannya","lalu Dia menentukannya"]},{"a":20,"ar":"ثُمَّ السَّبِيْلَ يَسَّرَهٗۙ","la":"Ṡummas-sabīla yassarah(ū).","id":"Kemudian, jalannya Dia mudahkan.746)","m":["kemudian","jalan","Dia memudahkannya"]},{"a":21,"ar":"ثُمَّ اَمَاتَهٗ فَاَقْبَرَهٗۙ","la":"Ṡumma amātahū fa aqbarah(ū).","id":"Kemudian, Dia mematikannya lalu menguburkannya.","m":["kemudian","Dia mematikannya","lalu Dia memasukkannya dalam kubur"]},{"a":22,"ar":"ثُمَّ اِذَا شَاۤءَ اَنْشَرَهٗۗ","la":"Ṡumma iżā syā'a ansyarah(ū).","id":"Kemudian, jika menghendaki, Dia membangkitkannya kembali.","m":["kemudian","apabila","Dia menghendaki","Dia membangkitkan"]},{"a":23,"ar":"كَلَّا لَمَّا يَقْضِ مَآ اَمَرَهٗۗ","la":"Kallā lammā yaqḍi mā amarah(ū).","id":"Sekali-kali jangan (begitu)! Dia (manusia) itu belum melaksanakan apa yang Dia (Allah) perintahkan kepadanya.","m":["sekali-kali jangan","belum","ia melaksanakan","apa","Dia perintahkan kepadanya"]},{"a":24,"ar":"فَلْيَنْظُرِ الْاِنْسَانُ اِلٰى طَعَامِهٖٓ ۙ","la":"Falyanẓuril-insānu ilā ṭa‘āmih(ī).","id":"Maka, hendaklah manusia itu memperhatikan makanannya.","m":["maka hendaklah ia memperhatikan","manusia","kepada","makanannya"]},{"a":25,"ar":"اَنَّا صَبَبْنَا الْمَاۤءَ صَبًّاۙ","la":"Annā ṣababnal-mā'a ṣabbā(n).","id":"Sesungguhnya Kami telah mencurahkan air (dari langit) dengan berlimpah.","m":["sesungguhnya kami","Kami telah mencurahkan","air","tercurah"]},{"a":26,"ar":"ثُمَّ شَقَقْنَا الْاَرْضَ شَقًّاۙ","la":"Ṡumma syaqaqnal-arḍa syaqqā(n).","id":"Kemudian, Kami belah bumi dengan sebaik-baiknya.","m":["kemudian","Kami belah","bumi","belahan (sebaik-baiknya)"]},{"a":27,"ar":"فَاَنْۢبَتْنَا فِيْهَا حَبًّاۙ","la":"Fa'ambatnā fīhā ḥabbā(n).","id":"Lalu, Kami tumbuhkan padanya biji-bijian,","m":["lalu Kami tumbuhkan","padanya","biji-bijian"]},{"a":28,"ar":"وَّعِنَبًا وَّقَضْبًاۙ","la":"Wa ‘inabaw wa qaḍbā(n).","id":"anggur, sayur-sayuran,","m":["dan angur","dan sayur-sayuran"]},{"a":29,"ar":"وَّزَيْتُوْنًا وَّنَخْلًاۙ","la":"Wa zaitūnaw wa nakhlā(n).","id":"zaitun, pohon kurma,","m":["dan zaitun","dan korma"]},{"a":30,"ar":"وَّحَدَاۤىِٕقَ غُلْبًا","la":"Wa ḥadā'iqa gulbā(n).","id":"kebun-kebun (yang) rindang,","m":["dan kebun-kebun","subur/lebat"]},{"a":31,"ar":"وَفَاكِهَةً وَّاَبًّا","la":"Wa fākihataw wa abbā(n).","id":"buah-buahan, dan rerumputan.","m":["dan buah-buahan","dan ruput-rumputan"]},{"a":32,"ar":"مَتَاعًا لَّكُمْ وَلِاَنْعَامِكُمْۗ","la":"Matā‘al lakum wa li'an‘āmikum.","id":"(Semua itu disediakan) untuk kesenanganmu dan hewan-hewan ternakmu.","m":["kesenangan","bagi kalian","dan bagi binatang ternakmu"]},{"a":33,"ar":"فَاِذَا جَاۤءَتِ الصَّاۤخَّةُ ۖ","la":"Fa iżā jā'atiṣ-ṣākhkhah(tu).","id":"Maka, apabila datang suara yang memekakkan (dari tiupan sangkakala),","m":["maka apabila","telah datang","suara memekakan"]},{"a":34,"ar":"يَوْمَ يَفِرُّ الْمَرْءُ مِنْ اَخِيْهِۙ","la":"Yauma yafirrul-mar'u min akhīh(i).","id":"pada hari itu manusia lari dari saudaranya,","m":["pada hari","lari","manusia","dari","saudaranya"]},{"a":35,"ar":"وَاُمِّهٖ وَاَبِيْهِۙ","la":"Wa ummihī wa abīh(i).","id":"(dari) ibu dan bapaknya,","m":["dan ibunya","dan bapaknya"]},{"a":36,"ar":"وَصَاحِبَتِهٖ وَبَنِيْهِۗ","la":"Wa ṣāḥibatihī wa banīh(i).","id":"serta (dari) istri dan anak-anaknya.","m":["dan istrinya","dan anak-anaknya"]},{"a":37,"ar":"لِكُلِّ امْرِئٍ مِّنْهُمْ يَوْمَىِٕذٍ شَأْنٌ يُّغْنِيْهِۗ","la":"Likullimri'im minhum yauma'iżin sya'nuy yugnīh(i).","id":"Setiap orang dari mereka pada hari itu mempunyai urusan yang menyibukkannya.","m":["bagi setiap","seseorang","dari mereka","pada hari itu","urusan","menyibukkan"]},{"a":38,"ar":"وُجُوْهٌ يَّوْمَىِٕذٍ مُّسْفِرَةٌۙ","la":"Wujūhuy yauma'iżim musfirah(tun).","id":"Pada hari itu ada wajah-wajah yang berseri-seri,","m":["wajah-wajah","pada hari itu","gembira ria"]},{"a":39,"ar":"ضَاحِكَةٌ مُّسْتَبْشِرَةٌ ۚ","la":"Ḍāḥikatum mustabsyirah(tun).","id":"tertawa lagi gembira ria.","m":["tertawa","gembira-ria"]},{"a":40,"ar":"وَوُجُوْهٌ يَّوْمَىِٕذٍ عَلَيْهَا غَبَرَةٌۙ","la":"Wa wujūhuy yauma'iżin ‘alaihā gabarah(tun).","id":"Pada hari itu ada (pula) wajah-wajah yang tertutup debu (suram)","m":["dan wajah-wajah","pada hari itu","atasnya","tertutup debu"]},{"a":41,"ar":"تَرْهَقُهَا قَتَرَةٌ ۗ","la":"Tarhaquhā qatarah(tun).","id":"dan tertutup oleh kegelapan (ditimpa kehinaan dan kesusahan).","m":["menutupinya","kegelapan"]},{"a":42,"ar":"اُولٰۤىِٕكَ هُمُ الْكَفَرَةُ الْفَجَرَةُ ࣖ","la":"Ulā'ika humul-kafaratul-fajarah(tu).","id":"Mereka itulah orang-orang kafir lagi para pendurhaka.","m":["mereka itulah","mereka","orang-orang kafir","durhaka"]}]}