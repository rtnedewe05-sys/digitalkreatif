{"n":96,"ayat":[{"a":1,"ar":"اِقْرَأْ بِاسْمِ رَبِّكَ الَّذِيْ خَلَقَۚ","la":"Iqra' bismi rabbikal-lażī khalaq(a).","id":"Bacalah dengan (menyebut) nama Tuhanmu yang menciptakan!","m":["bacalah","dengan nama","Tuhanmu","yang","menciptakan"]},{"a":2,"ar":"خَلَقَ الْاِنْسَانَ مِنْ عَلَقٍۚ","la":"Khalaqal-insāna min ‘alaq(in).","id":"Dia menciptakan manusia dari segumpal darah.","m":["menciptakan","manusia","dari","segumpal darah"]},{"a":3,"ar":"اِقْرَأْ وَرَبُّكَ الْاَكْرَمُۙ","la":"Iqra' wa rabbukal-akram(u).","id":"Bacalah! Tuhanmulah Yang Maha Mulia,","m":["bacalah","dan Tuhanmu","amat mulia"]},{"a":4,"ar":"الَّذِيْ عَلَّمَ بِالْقَلَمِۙ","la":"Allażī ‘allama bil-qalam(i).","id":"yang mengajar (manusia) dengan pena.","m":["yang","Dia mengajar","dengan kalam"]},{"a":5,"ar":"عَلَّمَ الْاِنْسَانَ مَا لَمْ يَعْلَمْۗ","la":"‘Allamal-insāna mā lam ya‘lam.","id":"Dia mengajarkan manusia apa yang tidak diketahuinya.","m":["Dia mengajarkan","manusia","apa","tidak","dia ketahui"]},{"a":6,"ar":"كَلَّآ اِنَّ الْاِنْسَانَ لَيَطْغٰىٓ ۙ","la":"Kallā innal-insāna layaṭgā.","id":"Sekali-kali tidak! Sesungguhnya manusia itu benar-benar melampaui batas","m":["sekali-kali tidak","sesungguhnya","manusia","benar-benar melampui batas"]},{"a":7,"ar":"اَنْ رَّاٰهُ اسْتَغْنٰىۗ","la":"Ar ra'āhustagnā.","id":"ketika melihat dirinya serba berkecukupan.","m":["bahwa","ia melihatnya","dia serba cukup"]},{"a":8,"ar":"اِنَّ اِلٰى رَبِّكَ الرُّجْعٰىۗ","la":"Inna ilā rabbikar-ruj‘ā.","id":"Sesungguhnya hanya kepada Tuhanmulah tempat kembali(-mu).","m":["sesungguhnya","kepada","Tuhanmu","tempat kembali"]},{"a":9,"ar":"اَرَاَيْتَ الَّذِيْ يَنْهٰىۙ","la":"Ara'aital-lażī yanhā.","id":"Tahukah kamu tentang orang yang melarang","m":["apakah kamu lihat/pendapatmu","yang/orang-orang","ia melarang"]},{"a":10,"ar":"عَبْدًا اِذَا صَلّٰىۗ","la":"‘Abdan iżā ṣallā.","id":"seorang hamba ketika dia melaksanakan salat?","m":["hamba","apabila","sholat"]},{"a":11,"ar":"اَرَاَيْتَ اِنْ كَانَ عَلَى الْهُدٰىٓۙ","la":"Ara'aita in kāna ‘alal-hudā.","id":"Bagaimana pendapatmu kalau terbukti dia berada di dalam kebenaran","m":["apakah kamu lihat/pendapatmu","jika","adalah","atas","petunjuk"]},{"a":12,"ar":"اَوْ اَمَرَ بِالتَّقْوٰىۗ","la":"Au amara bit-taqwā.","id":"atau dia menyuruh bertakwa (kepada Allah)?","m":["atau","dia menyuruh","dengan taqwa"]},{"a":13,"ar":"اَرَاَيْتَ اِنْ كَذَّبَ وَتَوَلّٰىۗ","la":"Ara'aita in każżaba wa tawallā.","id":"Bagaimana pendapatmu kalau dia mendustakan (kebenaran) dan berpaling (dari keimanan)?","m":["apakah kamu lihat/pendapatmu","jika","mendustakan","dan dia berpaling"]},{"a":14,"ar":"اَلَمْ يَعْلَمْ بِاَنَّ اللّٰهَ يَرٰىۗ","la":"Alam ya‘lam bi'annallāha yarā.","id":"Tidakkah dia mengetahui bahwa sesungguhnya Allah melihat (segala perbuatannya)?","m":["apakah tidak/tidaklah","dia mengetahui","bahwa sesungguhnya","Allah","Dia melihat"]},{"a":15,"ar":"كَلَّا لَىِٕنْ لَّمْ يَنْتَهِ ەۙ لَنَسْفَعًاۢ بِالنَّاصِيَةِۙ","la":"Kallā la'il lam yantah(i), lanasfa‘am bin-nāṣiyah(ti).","id":"Sekali-kali tidak! Sungguh, jika dia tidak berhenti (berbuat demikian), niscaya Kami tarik ubun-ubunnya (ke dalam neraka),","m":["sekali-kali tidak","sungguh jika","tidak","dia berhenti","niscaya kami pegang/tarik","dengan umbun-umbun"]},{"a":16,"ar":"نَاصِيَةٍ كَاذِبَةٍ خَاطِئَةٍۚ","la":"Nāṣiyatin kāżibatin khāṭi'ah(tin).","id":"(yaitu) ubun-ubun orang yang mendustakan (kebenaran) dan durhaka.","m":["umbun-umbun","pendusta","salah/durhaka"]},{"a":17,"ar":"فَلْيَدْعُ نَادِيَهٗۙ","la":"Falyad‘u nādiyah(ū).","id":"Biarlah dia memanggil golongannya (untuk menolongnya).","m":["maka hendaklah dia memanggil","kaum/golongannya"]},{"a":18,"ar":"سَنَدْعُ الزَّبَانِيَةَۙ","la":"Sanad‘uz-zabāniyah(ta).","id":"Kelak Kami akan memanggil (Malaikat) Zabaniah (penyiksa orang-orang yang berdosa).759)","m":["kelak Kami memanggil","Zabaniyah"]},{"a":19,"ar":"كَلَّاۗ  لَا تُطِعْهُ وَاسْجُدْ وَاقْتَرِبْ ۩ ࣖ","la":"Kallā, lā tuṭi‘hu wasjud waqtarib.","id":"Sekali-kali tidak! Janganlah patuh kepadanya, (tetapi) sujud dan mendekatlah (kepada Allah).","m":["sekali-kali","jangan","kamu patuh kepadanya","dan sujudlah","dan dekatkanlah"]}]}