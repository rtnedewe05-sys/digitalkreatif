{"n":94,"ayat":[{"a":1,"ar":"اَلَمْ نَشْرَحْ لَكَ صَدْرَكَۙ","la":"Alam nasyraḥ laka ṣadrak(a).","id":"Bukankah Kami telah melapangkan dadamu (Nabi Muhammad),","m":["apakah tidak/bukankah","Kami melapangkan","bagimu","dadamu"]},{"a":2,"ar":"وَوَضَعْنَا عَنْكَ وِزْرَكَۙ","la":"Wa waḍa‘nā ‘anka wizrak(a).","id":"meringankan beban (tugas-tugas kenabian) darimu","m":["dan Kami letakkan/turunkan","dari kamu","bebanmu"]},{"a":3,"ar":"الَّذِيْٓ اَنْقَضَ ظَهْرَكَۙ","la":"Allażī anqaḍa ẓahrak(a).","id":"yang memberatkan punggungmu,","m":["yang","memberatkan","punggungmu"]},{"a":4,"ar":"وَرَفَعْنَا لَكَ ذِكْرَكَۗ","la":"Wa rafa‘nā laka żikrak(a).","id":"dan meninggikan (derajat)-mu (dengan selalu) menyebut-nyebut (nama)-mu?","m":["dan Kami tinggikan","bagimu","sebutanmu"]},{"a":5,"ar":"فَاِنَّ مَعَ الْعُسْرِ يُسْرًاۙ","la":"Fa'inna ma‘al-‘usri yusrā(n).","id":"Maka, sesungguhnya beserta kesulitan ada kemudahan.","m":["maka sesungguhnya","beserta","kesulitan","kemudahan"]},{"a":6,"ar":"اِنَّ مَعَ الْعُسْرِ يُسْرًاۗ","la":"Inna ma‘al-‘usri yusrā(n).","id":"Sesungguhnya beserta kesulitan ada kemudahan.","m":["sesungguhnya","beserta","kesulitan","kemudahan"]},{"a":7,"ar":"فَاِذَا فَرَغْتَ فَانْصَبْۙ","la":"Fa iżā faragta fanṣab.","id":"Apabila engkau telah selesai (dengan suatu kebajikan), teruslah bekerja keras (untuk kebajikan yang lain)","m":["maka apabila","kamu telah selesai","maka kerja keraslah kamu"]},{"a":8,"ar":"وَاِلٰى رَبِّكَ فَارْغَبْ ࣖ","la":"Wa ilā rabbika fargab.","id":"dan hanya kepada Tuhanmu berharaplah!","m":["dan hanya","Tuhanmu","maka kamu berharap"]}]}