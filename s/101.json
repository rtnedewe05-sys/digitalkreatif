{"n":101,"ayat":[{"a":1,"ar":"اَلْقَارِعَةُۙ","la":"Al-qāri‘ah(tu).","id":"Al-Qāri‘ah (hari Kiamat yang menggetarkan).","m":["hari kiamat"]},{"a":2,"ar":"مَا الْقَارِعَةُ ۚ","la":"Mal-qāri‘ah(tu).","id":"Apakah al-Qāri‘ah itu?","m":["apakah","hari kiamat"]},{"a":3,"ar":"وَمَآ اَدْرٰىكَ مَا الْقَارِعَةُ ۗ","la":"Wa mā adrāka mal-qāri‘ah(tu).","id":"Tahukah kamu apakah al-Qāri‘ah itu?","m":["dan apakah","kamu tahu","apa","hari kiamat"]},{"a":4,"ar":"يَوْمَ يَكُوْنُ النَّاسُ كَالْفَرَاشِ الْمَبْثُوْثِۙ","la":"Yauma yakūnun-nāsu kal-farāsyil-mabṡūṡ(i).","id":"Pada hari itu manusia seperti laron yang beterbangan","m":["hari","adalah","manusia","seperti anai-anai","bertebaran"]},{"a":5,"ar":"وَتَكُوْنُ الْجِبَالُ كَالْعِهْنِ الْمَنْفُوْشِۗ","la":"Wa takūnul-jibālu kal-‘ihnil-manfūsy(i).","id":"dan gunung-gunung seperti bulu yang berhamburan.","m":["dan adalah","gunung-gunung","seperti bulu","dihambur-hamburkan"]},{"a":6,"ar":"فَاَمَّا مَنْ ثَقُلَتْ مَوَازِيْنُهٗۙ","la":"Fa ammā man ṡaqulat mawāzīnuh(ū).","id":"Siapa yang berat timbangan (kebaikan)-nya,","m":["maka adapun","siapa/orang","berat","timbangannya"]},{"a":7,"ar":"فَهُوَ فِيْ عِيْشَةٍ رَّاضِيَةٍۗ","la":"Fa huwa fī ‘īsyatir rāḍiyah(tin).","id":"dia berada dalam kehidupan yang menyenangkan.","m":["maka dia","dalam","kehidupan","memuaskan"]},{"a":8,"ar":"وَاَمَّا مَنْ خَفَّتْ مَوَازِيْنُهٗۙ","la":"Wa ammā man khaffat mawāzīnuh(ū).","id":"Adapun orang yang ringan timbangan (kebaikan)-nya,","m":["dan adapun","orang","ringan","timbangannya"]},{"a":9,"ar":"فَاُمُّهٗ هَاوِيَةٌ  ۗ","la":"Fa ummuhū hāwiyah(tun).","id":"tempat kembalinya adalah (neraka) Hawiyah.","m":["maka tempat kembalinya","jurang yang dalam/neraka Hawiyah"]},{"a":10,"ar":"وَمَآ اَدْرٰىكَ مَا هِيَهْۗ","la":"Wa mā adrāka mā hiyah.","id":"Tahukah kamu apakah (neraka Hawiyah) itu?","m":["dan apakah","kamu tahu","apa","itu"]},{"a":11,"ar":"نَارٌ حَامِيَةٌ ࣖ","la":"Nārun ḥāmiyah(tun).","id":"(Ia adalah) api yang sangat panas.","m":["api","sangat panas"]}]}