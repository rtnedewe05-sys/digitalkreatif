{"n":86,"ayat":[{"a":1,"ar":"وَالسَّمَاۤءِ وَالطَّارِقِۙ","la":"Was-samā'i waṭ-ṭāriq(i).","id":"Demi langit dan yang datang pada malam hari.","m":["dan langit","dan yang datang di malam hari"]},{"a":2,"ar":"وَمَآ اَدْرٰىكَ مَا الطَّارِقُۙ","la":"Wa mā adrāka maṭ-ṭāriq(u).","id":"Tahukah kamu apakah yang datang pada malam hari itu?","m":["dan apa","kamu tahu","apa","yang datang dimalam hari"]},{"a":3,"ar":"النَّجْمُ الثَّاقِبُۙ","la":"An-najmuṡ-ṡāqib(u).","id":"(Itulah) bintang yang bersinar tajam.","m":["bintang","cemerlang/menembus"]},{"a":4,"ar":"اِنْ كُلُّ نَفْسٍ لَّمَّا عَلَيْهَا حَافِظٌۗ","la":"In kullu nafsil lammā ‘alaihā ḥāfiẓ(un).","id":"Setiap orang pasti ada penjaganya.","m":["tidak","setiap","jiwa/diri","melainkan","atasnya","penjaga"]},{"a":5,"ar":"فَلْيَنْظُرِ الْاِنْسَانُ مِمَّ خُلِقَ","la":"Falyanẓuril-insānu mimma khuliq(a).","id":"Hendaklah manusia memperhatikan dari apa dia diciptakan.","m":["maka hendaklah memperhatikan","manusia","dari apa","ia diciptakan"]},{"a":6,"ar":"خُلِقَ مِنْ مَّاۤءٍ دَافِقٍۙ","la":"Khuliqa mim mā'in dāfiq(in).","id":"Dia diciptakan dari air (mani) yang memancar,","m":["ia diciptakan","dari","air","terpancar"]},{"a":7,"ar":"يَّخْرُجُ مِنْۢ بَيْنِ الصُّلْبِ وَالتَّرَاۤىِٕبِۗ","la":"Yakhruju mim bainiṣ-ṣulbi wat-tarā'ib(i).","id":"yang keluar dari antara tulang sulbi (punggung) dan tulang dada.","m":["ia keluar","dari","antara","tulang belakang","dan tulang dada"]},{"a":8,"ar":"اِنَّهٗ عَلٰى رَجْعِهٖ لَقَادِرٌۗ","la":"Innahū ‘alā raj‘ihī laqādir(un).","id":"Sesungguhnya Dia (Allah) benar-benar kuasa untuk mengembalikannya (hidup setelah mati)","m":["sesungguhnya Dia","atas","mengembalikanya","benar-benar berkuasa"]},{"a":9,"ar":"يَوْمَ تُبْلَى السَّرَاۤىِٕرُۙ","la":"Yauma tublas-sarā'ir(u).","id":"pada hari ditampakkan segala rahasia.","m":["hari","dibuka/dinampakkan","rahasia-rahasia"]},{"a":10,"ar":"فَمَا لَهٗ مِنْ قُوَّةٍ وَّلَا نَاصِرٍۗ","la":"Famā lahū min quwwatiw wa lā nāṣir(in).","id":"Maka, baginya (manusia) tidak ada lagi kekuatan dan tidak (pula) ada penolong.","m":["maka tidak","baginya","dari","kekuatan","dan tidak","seorang penolong"]},{"a":11,"ar":"وَالسَّمَاۤءِ ذَاتِ الرَّجْعِۙ","la":"Was-samā'i żātir-raj‘(i).","id":"Demi langit yang mengandung hujan753)","m":["dan langit","mempunyai/mengandung","air/hujan"]},{"a":12,"ar":"وَالْاَرْضِ ذَاتِ الصَّدْعِۙ","la":"Wal-arḍi żātiṣ-ṣad‘(i).","id":"dan bumi yang memiliki rekahan (tempat tumbuhnya pepohonan),","m":["dan bumi","mempunyai","tumbuh-tumbuhan"]},{"a":13,"ar":"اِنَّهٗ لَقَوْلٌ فَصْلٌۙ","la":"Innahū laqaulun faṣl(un).","id":"sesungguhnya (Al-Qur’an) itu benar-benar firman pemisah (antara yang hak dan yang batil)","m":["sesungguhnya ia (Al Qur'an)","perkataan/firman","terpisah"]},{"a":14,"ar":"وَّمَا هُوَ بِالْهَزْلِۗ","la":"Wa mā huwa bil-hazl(i).","id":"dan ia (Al-Qur’an) sama sekali bukan perkataan senda gurau.","m":["dan tidak","ia (Al Qur'an)","dengan sia-sia/senda gurau"]},{"a":15,"ar":"اِنَّهُمْ يَكِيْدُوْنَ كَيْدًاۙ","la":"Innahum yakīdūna kaidā(n).","id":"Sesungguhnya mereka (orang kafir) melakukan tipu daya.","m":["sesungguhnya mereka","mereka membuat tipu daya","tipu daya"]},{"a":16,"ar":"وَّاَكِيْدُ كَيْدًاۖ","la":"Wa akīdu kaidā(n).","id":"Aku pun membalasnya dengan tipu daya.","m":["dan AKu membuat tipu daya","tipu daya"]},{"a":17,"ar":"فَمَهِّلِ الْكٰفِرِيْنَ اَمْهِلْهُمْ رُوَيْدًا ࣖ","la":"Fa mahhilil-kāfirīna amhilhum ruwaidā(n).","id":"Maka, tangguhkanlah orang-orang kafir itu. Biarkanlah mereka sejenak (bersenang-senang).","m":["maka beri tangguhlah","orang-orang kafir","beritangguhlah mereka","sedikit/sebentar"]}]}