{"n":104,"ayat":[{"a":1,"ar":"وَيْلٌ لِّكُلِّ هُمَزَةٍ لُّمَزَةٍۙ","la":"Wailul likulli humazatil-lumazah(tin).","id":"Celakalah setiap pengumpat lagi pencela","m":["kecelakaan","bagi setiap","pengumpat","pencela"]},{"a":2,"ar":"ۨالَّذِيْ جَمَعَ مَالًا وَّعَدَّدَهٗۙ","la":"Allażī jama‘a mālaw wa ‘addadah(ū).","id":"yang mengumpulkan harta dan menghitung-hitungnya.","m":["yang","mengumpulkan","harta","dan dia menghitungnya"]},{"a":3,"ar":"يَحْسَبُ اَنَّ مَالَهٗٓ اَخْلَدَهٗۚ","la":"Yaḥsabu anna mālahū akhladah(ū).","id":"Dia (manusia) mengira bahwa hartanya dapat mengekalkannya.","m":["dia mengira","bahwasanya","hartanya","mengekalkannya"]},{"a":4,"ar":"كَلَّا لَيُنْۢبَذَنَّ فِى الْحُطَمَةِۖ","la":"Kallā layumbażanna fil-ḥuṭamah(ti).","id":"Sekali-kali tidak! Pasti dia akan dilemparkan ke dalam (neraka) Hutamah.","m":["sekali-kali tidak","sungguh dia akan dilemparkan","dalam","Hutamah"]},{"a":5,"ar":"وَمَآ اَدْرٰىكَ مَا الْحُطَمَةُ ۗ","la":"Wa mā adrāka mal-ḥuṭamah(tu).","id":"Tahukah kamu apakah (neraka) Hutamah?","m":["dan apakah","kamu tahu","apa","Hutamah"]},{"a":6,"ar":"نَارُ اللّٰهِ الْمُوْقَدَةُۙ","la":"Nārullāhil-mūqadah(tu).","id":"(Ia adalah) api (azab) Allah yang dinyalakan","m":["api","Allah","dinyalakan"]},{"a":7,"ar":"الَّتِيْ تَطَّلِعُ عَلَى الْاَفْـِٕدَةِۗ","la":"Allatī taṭṭali‘u ‘alal-af'idah(ti).","id":"yang (membakar) naik sampai ke hati.","m":["yang","naik","ke atas/sampai","hati"]},{"a":8,"ar":"اِنَّهَا عَلَيْهِمْ مُّؤْصَدَةٌۙ","la":"Innahā ‘alaihim mu'ṣadah(tun).","id":"Sesungguhnya dia (api itu) tertutup rapat (sebagai hukuman) atas mereka,","m":["sesungguhnya ia (api)","atas mereka","terikat/ditutup rapat"]},{"a":9,"ar":"فِيْ عَمَدٍ مُّمَدَّدَةٍ ࣖ","la":"Fī ‘amadim mumaddadah(tin).","id":"(sedangkan mereka) diikat pada tiang-tiang yang panjang.","m":["dalam/pada","tiang","panjang"]}]}