{"n":114,"ayat":[{"a":1,"ar":"قُلْ اَعُوْذُ بِرَبِّ النَّاسِۙ","la":"Qul a‘ūżu birabbin-nās(i).","id":"Katakanlah (Nabi Muhammad), “Aku berlindung kepada Tuhan manusia,","m":["katakanlah","aku berlindung","Tuhannya","manusia"]},{"a":2,"ar":"مَلِكِ النَّاسِۙ","la":"Malikin-nās(i).","id":"raja manusia,","m":["Rajanya","manusia"]},{"a":3,"ar":"اِلٰهِ النَّاسِۙ","la":"Ilāhin-nās(i).","id":"sembahan manusia","m":["Tuhannya","manusia"]},{"a":4,"ar":"مِنْ شَرِّ الْوَسْوَاسِ ەۙ الْخَنَّاسِۖ","la":"Min syarril-waswāsil-khannās(i).","id":"dari kejahatan (setan) pembisik yang bersembunyi","m":["dari","kejahatan","bisikkan","menunggu-nunggu/bersembunyi"]},{"a":5,"ar":"الَّذِيْ يُوَسْوِسُ فِيْ صُدُوْرِ النَّاسِۙ","la":"Allażī yuwaswisu fī ṣudūrin-nās(i).","id":"yang membisikkan (kejahatan) ke dalam dada manusia,","m":["yang","membisik-bisikan","dalam","dada","manusia"]},{"a":6,"ar":"مِنَ الْجِنَّةِ وَالنَّاسِ ࣖ","la":"Minal jinnati wan-nās(i).","id":"dari (golongan) jin dan manusia.”","m":["dari","jin","dan manusia"]}]}