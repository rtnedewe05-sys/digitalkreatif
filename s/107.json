{"n":107,"ayat":[{"a":1,"ar":"اَرَءَيْتَ الَّذِيْ يُكَذِّبُ بِالدِّيْنِۗ","la":"Ara'aital-lażī yukażżibu bid-dīn(i).","id":"Tahukah kamu (orang) yang mendustakan agama?","m":["tahukah kamu","yang","dia mendustakan","dengan agama"]},{"a":2,"ar":"فَذٰلِكَ الَّذِيْ يَدُعُّ الْيَتِيْمَۙ","la":"Fa żālikal-lażī yadu‘‘ul-yatīm(a).","id":"Itulah orang yang menghardik anak yatim","m":["maka itulah","yang","dia menghardik","anak yatim"]},{"a":3,"ar":"وَلَا يَحُضُّ عَلٰى طَعَامِ الْمِسْكِيْنِۗ","la":"Wa lā yaḥuḍḍu ‘alā ṭa‘āmil-miskīn(i).","id":"dan tidak menganjurkan untuk memberi makan orang miskin.","m":["dan tidak","menganjurkan","atas","memberi makan","orang miskin"]},{"a":4,"ar":"فَوَيْلٌ لِّلْمُصَلِّيْنَۙ","la":"Fawailul lil-muṣallīn(a).","id":"Celakalah orang-orang yang melaksanakan salat,","m":["maka celakalah","orang yang sholat"]},{"a":5,"ar":"الَّذِيْنَ هُمْ عَنْ صَلَاتِهِمْ سَاهُوْنَۙ","la":"Allażīna hum ‘an ṣalātihim sāhūn(a).","id":"(yaitu) yang lalai terhadap salatnya,761)","m":["orang-orang yang","mereka","dar","sholat mereka","lalai"]},{"a":6,"ar":"الَّذِيْنَ هُمْ يُرَاۤءُوْنَۙ","la":"Allażīna hum yurā'ūn(a).","id":"yang berbuat riya,762)","m":["orang-orang yang","mereka","mereka berbuat ria"]},{"a":7,"ar":"وَيَمْنَعُوْنَ الْمَاعُوْنَ ࣖ","la":"Wa yamna‘ūnal-mā‘ūn(a).","id":"dan enggan (memberi) bantuan.","m":["dan mereka mencegah/enggan","pertolongan"]}]}