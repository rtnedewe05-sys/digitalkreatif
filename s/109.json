{"n":109,"ayat":[{"a":1,"ar":"قُلْ يٰٓاَيُّهَا الْكٰفِرُوْنَۙ","la":"Qul yā ayyuhal-kāfirūn(a).","id":"Katakanlah (Nabi Muhammad), “Wahai orang-orang kafir,","m":["katakanlah","wahai","orang-orang kafir"]},{"a":2,"ar":"لَآ اَعْبُدُ مَا تَعْبُدُوْنَۙ","la":"Lā a‘budu mā ta‘budūn(a).","id":"aku tidak akan menyembah apa yang kamu sembah.","m":["tidak","aku menyembah","apa","kamu sembah"]},{"a":3,"ar":"وَلَآ اَنْتُمْ عٰبِدُوْنَ مَآ اَعْبُدُۚ","la":"Wa lā antum ‘ābidūna mā a‘bud(u).","id":"Kamu juga bukan penyembah apa yang aku sembah.","m":["dan tidak","kamu","menyembah","apa","aku sembah"]},{"a":4,"ar":"وَلَآ اَنَا۠ عَابِدٌ مَّا عَبَدْتُّمْۙ","la":"Wa lā ana ‘ābidum mā ‘abattum.","id":"Aku juga tidak pernah menjadi penyembah apa yang kamu sembah.","m":["dan bukanlah","aku","menjadi penyembah","apa","kamu sembah"]},{"a":5,"ar":"وَلَآ اَنْتُمْ عٰبِدُوْنَ مَآ اَعْبُدُۗ","la":"Wa lā antum ‘ābidūna mā a‘bud(u).","id":"Kamu tidak pernah (pula) menjadi penyembah apa yang aku sembah.","m":["dan bukanlah","kamu","menyembah","apa","aku sembah"]},{"a":6,"ar":"لَكُمْ دِيْنُكُمْ وَلِيَ دِيْنِ ࣖ","la":"Lakum dīnukum wa liya dīn(i).","id":"Untukmu agamamu dan untukku agamaku.”","m":["bagi kalian","agamamu","bagiku","agamaku"]}]}